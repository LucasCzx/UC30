programa {
    funcao inicio() {
        real imovel, salario, mensal
        inteiro anos, meses
        escreva("Qual é o valor da casa?  \n")
        leia(imovel)

        escreva("Qual é o seu salário:  \n")
        leia(salario)

        escreva("Quantos meses você irá pagar?  \n")
        leia(mensal)

        salario * 0.30
        
    }
}